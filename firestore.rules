// Firestore security rules for blood-donor-app-e274e.
//
// Paste this whole file into:
//   Firebase Console → Firestore Database → Rules tab → Replace + Publish
//
// These rules are intentionally permissive for the demo. Tighten them
// before any real-world deployment — see the END notes below for a
// production-grade pattern.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public catalog: anyone (signed in or not) can read donor & receiver
    // tokens and live request status. Writes require an authenticated user.
    match /donors/{tokenId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /receivers/{tokenId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /requests/{requestId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User profiles: a user can read/write only their own doc.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ID counters: any authenticated user can read/write (transactions
    // serialize them anyway).
    match /counters/{counterId} {
      allow read, write: if request.auth != null;
    }

    // Seed metadata: readable by anyone, writable so the first-boot client
    // can claim the seed slot. Tighten to admin-only post-seed.
    match /meta/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}

// PRODUCTION NOTES
// - Replace the public read on donors/receivers/requests with a per-doc
//   `ownerEmail`/`recipientEmail` check so only the involved parties see
//   private info (phone numbers especially).
// - Lock down /meta and /counters writes to a custom admin claim.
// - Add field-level validation in `allow create:` to prevent malformed docs.
